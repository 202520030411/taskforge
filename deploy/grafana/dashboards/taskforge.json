   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 8,
   "title": "Requests paid twice",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 18,
