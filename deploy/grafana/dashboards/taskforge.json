  },
  {
   "id": 10,
   "title": "Sandbox hand-out time (95% under)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "pool = handed a pre-started container; cold = had to start one.",
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, source) (rate(taskforge_sandbox_start_seconds_bucket[1m])))",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   }
  },
  {
