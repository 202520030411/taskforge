{
 "uid": "taskforge",
 "title": "TaskForge",
 "timezone": "America/New_York",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Steps waiting, by resource class",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Queue length. Paid classes also count steps of runs that are not approved yet.",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (resource) (taskforge_steps{status=\"PENDING\"})",
     "legendFormat": "{{resource}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "title": "Steps running, by resource class",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (resource) (taskforge_steps{status=\"RUNNING\"})",
     "legendFormat": "{{resource}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "title": "Steps finished per second",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(taskforge_step_transitions_total{to_status=\"SUCCEEDED\"}[1m]))",
     "legendFormat": "succeeded",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(taskforge_step_transitions_total{to_status=\"FAILED\"}[1m]))",
     "legendFormat": "failed",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "title": "Oldest step waiting to be picked up",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "If this keeps growing for one class, that class needs more worker threads or more sandbox capacity.",
   "gridPos": {
    "x": 12,
    "y": 7,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "taskforge_queue_oldest_seconds",
     "legendFormat": "{{resource}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "title": "Leases expired",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Steps whose worker stopped renewing its claim; another worker ran them again.",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "taskforge_lease_expired_total",
     "legendFormat": "taken over",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 6,
   "title": "Commits refused (fenced)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "A worker tried to write a result after losing its claim. Refusing it is the correct outcome.",
   "gridPos": {
    "x": 6,
    "y": 14,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "taskforge_fenced_commits_total",
     "legendFormat": "fenced",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value_and_name"
   }
  },
  {
   "id": 7,
   "title": "Retries after faults",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
